mkdir secret-santa
cd secret-santa

git init -b main

dotnet new sln -n SecretSanta
dotnet new gitignore
dotnet new editorconfig

dotnet new globaljson \
  --sdk-version "$(dotnet --version)" \
  --roll-forward latestPatch

dotnet new blazor \
  -n SecretSanta.Web \
  -o src/SecretSanta.Web \
  -f net10.0

dotnet new xunit \
  -n SecretSanta.Tests \
  -o tests/SecretSanta.Tests \
  -f net10.0

dotnet sln add src/SecretSanta.Web
dotnet sln add tests/SecretSanta.Tests

dotnet add tests/SecretSanta.Tests \
  reference src/SecretSanta.Web