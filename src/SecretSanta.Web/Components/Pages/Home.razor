@page "/"
@rendermode InteractiveServer
@using SecretSanta.Web.Features.Drawing
@using System.ComponentModel.DataAnnotations
@using SecretSanta.Web.Infrastructure.Email
@inject IEmailService EmailService

<PageTitle>Secret Santa</PageTitle>

<div class="container py-4">
    <fieldset disabled="@HasDraw">
        <h1>Secret Santa 🎄</h1>
        <p>Add your participants and let us handle the draw.</p>

        <h3>Participants</h3>

        @foreach (var participant in participants)
        {
            <div class="row mb-3" @key="participant.Id">
                <div class="col">
                    <input class="form-control" placeholder="Name" aria-label="Participant name" @bind="participant.Name"
                           @bind:event="oninput" />
                </div>

                <div class="col">
                    <input class="form-control" type="email" placeholder="Email address" aria-label="Participant email"
                           @bind="participant.Email" />
                </div>

                <div class="col-auto">
                    <button class="btn btn-outline-danger" @onclick="() => RemoveParticipant(participant)">
                        Remove
                    </button>
                </div>
            </div>
        }

        <button class="btn btn-outline-primary" @onclick="AddParticipant">
            + Add participant
        </button>

        <hr />

        <h3>Spouse exclusions</h3>
        <p>Spouses cannot draw each other.</p>

        @foreach (var pair in spousePairs)
        {
            <div class="row mb-3" @key="pair">
                <div class="col">
                    <select class="form-select" aria-label="First spouse" @bind="pair.FirstParticipantId">
                        <option value="">Select participant</option>

                        @foreach (var participant in participants)
                        {
                            <option value="@participant.Id">
                                @participant.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col">
                    <select class="form-select" aria-label="Second spouse" @bind="pair.SecondParticipantId">
                        <option value="">Select participant</option>

                        @foreach (var participant in participants)
                        {
                            <option value="@participant.Id">
                                @participant.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-auto">
                    <button class="btn btn-outline-danger" @onclick="() => RemoveSpousePair(pair)">
                        Remove
                    </button>
                </div>
            </div>
        }

        <button class="btn btn-outline-primary" @onclick="AddSpousePair">
            + Add couple
        </button>

        <hr />

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }

        @if (successMessage is not null)
        {
            <div class="alert alert-success" role="status">
                @successMessage
            </div>
        }

        <button class="btn btn-success btn-lg" @onclick="Draw">
            Draw names
        </button>
    </fieldset>

    @if (HasDraw && !sendingStarted)
    {
        <button class="btn btn-outline-secondary" @onclick="CancelDraw">
            Cancel draw and edit participants
        </button>
    }

    @if (HasDraw)
    {
        <div class="mt-3">
            <p>
                @sentParticipantIds.Count of @assignments.Count
                emails submitted.
            </p>

            <progress value="@sentParticipantIds.Count" max="@assignments.Count">
            </progress>

            <div class="mt-2">
                <button class="btn btn-success" disabled="@(isSending || AllEmailsSent)" @onclick="SendEmailsAsync">
                    @if (isSending)
                    {
                        <span>Sending emails...</span>
                    }
                    else if (AllEmailsSent)
                    {
                        <span>All emails submitted!</span>
                    }
                    else if (sendingStarted)
                    {
                        <span>Retry remaining emails</span>
                    }
                    else
                    {
                        <span>Send @PendingEmailCount emails</span>
                    }
                </button>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<ParticipantInput> participants =
    [
        new(),
        new()
    ];

    private readonly List<SpousePairInput> spousePairs = [];

    private IReadOnlyList<Assignment> assignments = [];

    private string? errorMessage;
    private string? successMessage;

    private Guid drawId;
    private bool isSending;
    private bool sendingStarted;

    private readonly HashSet<Guid> sentParticipantIds = [];

    private bool HasDraw => assignments.Count > 0;

    private bool AllEmailsSent =>
        HasDraw && sentParticipantIds.Count == assignments.Count;

    private int PendingEmailCount =>
        assignments.Count - sentParticipantIds.Count;

    private void AddParticipant()
    {
        participants.Add(new ParticipantInput());
    }

    private void RemoveParticipant(ParticipantInput participant)
    {
        participants.Remove(participant);

        spousePairs.RemoveAll(pair =>
            pair.FirstParticipantId == participant.Id ||
            pair.SecondParticipantId == participant.Id);
    }

    private void AddSpousePair()
    {
        spousePairs.Add(new SpousePairInput());
    }

    private void RemoveSpousePair(SpousePairInput pair)
    {
        spousePairs.Remove(pair);
    }

    private void Draw()
    {
        errorMessage = null;
        successMessage = null;
        assignments = [];

        if (HasDraw || isSending)
        {
            return;
        }

        try
        {
            ValidateForm();

            var drawParticipants = participants
                .Select(participant => participant.ToParticipant())
                .ToArray();

            var drawSpousePairs = spousePairs
                .Select(pair => new SpousePair(
                    pair.FirstParticipantId!.Value,
                    pair.SecondParticipantId!.Value))
                .ToArray();

            assignments = MatchingAlgorithm.Draw(
                drawParticipants,
                drawSpousePairs);

            successMessage =
                $"Successfully generated {assignments.Count} assignments.";

            drawId = Guid.NewGuid();
            sentParticipantIds.Clear();
            sendingStarted = false;
        }
        catch (ArgumentException exception)
        {
            errorMessage = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
    }

    private void CancelDraw()
    {
        if (sendingStarted || isSending)
        {
            return;
        }

        assignments = [];
        sentParticipantIds.Clear();
        drawId = Guid.Empty;
        errorMessage = null;
        successMessage = null;
    }

    private void ValidateForm()
    {
        if (participants.Count < 2)
        {
            throw new ArgumentException(
                "At least two participants are required.");
        }

        var emailValidator = new EmailAddressAttribute();

        foreach (var participant in participants)
        {
            if (string.IsNullOrWhiteSpace(participant.Name))
            {
                throw new ArgumentException(
                    "Every participant must have a name.");
            }

            if (string.IsNullOrWhiteSpace(participant.Email) ||
                !emailValidator.IsValid(participant.Email.Trim()))
            {
                throw new ArgumentException(
                    $"{participant.Name} must have a valid email address.");
            }
        }

        var uniqueEmailCount = participants
            .Select(participant => participant.Email.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        @* if (uniqueEmailCount != participants.Count)
        {
            throw new ArgumentException(
                "Every participant must have a unique email address.");
        } *@

        if (spousePairs.Any(pair =>
            pair.FirstParticipantId is null ||
            pair.SecondParticipantId is null))
        {
            throw new ArgumentException(
                "Please complete all spouse pairs.");
        }
    }

    private async Task SendEmailsAsync()
    {
        if (isSending || !HasDraw || AllEmailsSent)
        {
            return;
        }

        isSending = true;
        sendingStarted = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            foreach (var assignment in assignments)
            {
                if (sentParticipantIds.Contains(assignment.Giver.Id))
                {
                    continue;
                }

                try
                {
                    await EmailService.SendAssignmentAsync(
                        drawId,
                        assignment);

                    sentParticipantIds.Add(assignment.Giver.Id);
                }
                catch (HttpRequestException)
                {
                    // Leave the assignment pending for retry.
                }
                catch (OperationCanceledException)
                {
                    // Leave the assignment pending for retry.
                }

                StateHasChanged();
            }

            if (AllEmailsSent)
            {
                successMessage =
                    "All Secret Santa emails have been submitted!";
            }
            else
            {
                errorMessage =
                    $"{PendingEmailCount} emails could not be confirmed. " +
                    "Please retry the remaining emails.";
            }
        }
        finally
        {
            isSending = false;
        }
    }
}
